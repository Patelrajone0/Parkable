# ==============================================================
# PARKEASE / PARKABLE ENVIRONMENT CONFIGURATION
# ==============================================================

# Supabase Credentials (Optional for production cloud DB)
# When provided, user accounts, spot listings, and bookings sync directly to your PostgreSQL database.
# When omitted, Parkable runs seamlessly with client-side reactive localStorage persistence!
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Payment Gateway: Razorpay (India - UPI, Google Pay, PhonePe, Paytm, Indian Cards & NetBanking)
# Obtain from https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_yourKeyHere
RAZORPAY_KEY_ID=rzp_test_yourKeyHere
RAZORPAY_KEY_SECRET=yourRazorpaySecretHere

# Payment Gateway: Stripe (Global - International Cards, Apple Pay, Google Pay)
# Obtain from https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_yourPublishableKeyHere
STRIPE_SECRET_KEY=sk_test_yourSecretKeyHere

# Company Treasury & Commission Account (Where your platform commission fees are credited)
NEXT_PUBLIC_COMPANY_NAME="ParkEase Technologies Pvt Ltd"
COMPANY_BANK_ACCOUNT=50200928190281
COMPANY_BANK_IFSC=HDFC0001092
COMPANY_UPI_ID=parkease.commission@hdfcbank

# Optional: Mapbox Token (if you prefer Mapbox raster/vector tiles instead of default CartoDB Positron)
# NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-token
