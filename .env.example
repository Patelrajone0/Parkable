# ==============================================================
# PARKEASE / PARKABLE ENVIRONMENT CONFIGURATION
# ==============================================================

# Supabase Credentials (Optional for production cloud DB)
# When provided, user accounts, spot listings, and bookings sync directly to your PostgreSQL database.
# When omitted, Parkable runs seamlessly with client-side reactive localStorage persistence!
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Mapbox Token (if you prefer Mapbox raster/vector tiles instead of default CartoDB Positron)
# NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-token
